# Forked from pigweed's targets/stm32f429i_disc1_stm32cube/BUILD.bazel.
# Differences from the F429 target: STM32F407xx product define (not
# STM32F429xx), 1MB flash linker region (not 2MB -- F407VG has 1MB, unlike
# the F429ZI/ZG this was forked from), and no pw_unit_test wiring (added
# later if/when on-device unit tests are needed).

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@pigweed//pw_build:merge_flags.bzl", "flags_from_dict")
load("@pigweed//pw_build:pw_linker_script.bzl", "pw_linker_script")
load("@pigweed//third_party/freertos:flags.bzl", "FREERTOS_FLAGS")

package(
    default_visibility = ["//visibility:public"],
    features = ["-layering_check"],
)

licenses(["notice"])

cc_library(
    name = "freertos_config",
    hdrs = [
        "config/FreeRTOSConfig.h",
    ],
    strip_include_prefix = "config",
    target_compatible_with = [":freertos_config_cv"],
    deps = ["@pigweed//third_party/freertos:config_assert"],
)

# Constraint value corresponding to :freertos_config.
#
# If you include this in your platform definition, you will tell Bazel to use
# the :freertos_config defined above when compiling FreeRTOS.  (See
# @pigweed//third_party/freertos/BUILD.bazel.) If you include it in a
# target's `target_compatible_with`, you will tell Bazel the target can only
# be built for platforms that specify this FreeRTOS config.
constraint_value(
    name = "freertos_config_cv",
    constraint_setting = "@freertos//:freertos_config_setting",
)

platform(
    name = "stm32f407g_freertos",
    constraint_values = [
        ":freertos_config_cv",
        "@pigweed//pw_build/constraints/rtos:freertos",
        "@pigweed//pw_interrupt_cortex_m:compatible",
        "@pigweed//pw_malloc:bucket_allocator_backend",
        "@freertos//:port_ARM_CM4F",
        "@freertos//:disable_task_statics",
        "@platforms//cpu:armv7e-m",
        "@platforms//os:none",
        "@pigweed//pw_build/constraints/arm:cortex-m4",
        "@pigweed//pw_build/constraints/rust:no_std",
        # USB OTG FS is a Synopsys DWC2 core; use TinyUSB's driver for it.
        "@tinyusb//:port_synopsys_stm32",
    ],
    flags = flags_from_dict(FREERTOS_FLAGS | {
        "@cmsis_core//:cc_defines": ":cc_defines",
        "@pigweed//pw_assert:check_backend": "@pigweed//pw_assert_basic",
        "@pigweed//pw_assert:check_backend_impl": "@pigweed//pw_assert_basic:impl",
        "@pigweed//pw_boot:backend": "@pigweed//pw_boot_cortex_m",
        "@pigweed//pw_interrupt:backend": "@pigweed//pw_interrupt_cortex_m:impl",
        # No log path off this board (the ST-LINK doesn't bridge a UART), so
        # logs compile to nothing. pw_system's log/RPC threads, which this
        # used to feed, reserved about 50 KB of RAM.
        "@pigweed//pw_log:backend": "@pigweed//pw_log_null",
        "@pigweed//pw_log:backend_impl": "@pigweed//pw_build:empty_cc_library",
        "@pigweed//pw_malloc:backend": "@pigweed//pw_malloc:bucket_allocator",
        "@pigweed//pw_sys_io:backend": "@pigweed//pw_sys_io_stm32cube",
        "@pigweed//pw_toolchain/arm_gcc:freestanding": "False",
        "@stm32f4xx_hal_driver//:hal_config": "//targets/stm32f407g_disc1:hal_config",
        "@tinyusb//:tinyusb_config": "//modules/usb_audio:tusb_config",
        "@tinyusb//:tinyusb_descriptors": "//modules/usb_audio:descriptors",
    }),
)

cc_library(
    name = "cc_defines",
    defines = [
        "STM32CUBE_HEADER=\\\"stm32f4xx.h\\\"",
        "STM32F407xx",
        # pw_sys_io_stm32cube defaults to USART1 (PA9/PA10, the F429I-DISC1's
        # choice). Try USART2 (PA2/PA3) instead: it's the common ST-LINK
        # VCP-bridge pairing on eval boards, and PA2/PA3 aren't used by the
        # onboard mic (I2S2: PB10/PC3) or codec (I2S3/I2C1), so it's safe to
        # repurpose regardless of whether the VCP is actually bridged here.
        "PW_SYS_IO_STM32CUBE_USART_NUM=2",
        "PW_SYS_IO_STM32CUBE_GPIO_PORT=A",
        "PW_SYS_IO_STM32CUBE_GPIO_TX_PIN=2",
        "PW_SYS_IO_STM32CUBE_GPIO_RX_PIN=3",
    ],
)

cc_library(
    name = "hal_config",
    hdrs = [
        "config/stm32f4xx_hal_conf.h",
    ],
    strip_include_prefix = "config",
    tags = ["noclangtidy"],
)

cc_library(
    name = "pre_init",
    srcs = [
        "boot.cc",
        "vector_table.c",
    ],
    copts = ["-Wno-return-type"],
    defines = ["PW_MALLOC_ACTIVE=1"],
    implementation_deps = ["@pigweed//pw_assert:check"],
    target_compatible_with = [":freertos_config_cv"],
    deps = [
        ":freertos_config",
        "@pigweed//pw_boot",
        "@pigweed//pw_boot_cortex_m",
        "@pigweed//pw_malloc",
        "@pigweed//pw_memory:busy_wait_forever",
        "@pigweed//pw_preprocessor",
        "@pigweed//pw_string",
        "@pigweed//pw_sys_io_stm32cube",
        "@pigweed//third_party/freertos:support",
        "@pigweed//third_party/stm32cube",
        "@freertos",
    ],
    alwayslink = 1,
)

cc_library(
    name = "extra_platform_libs",
    deps = [
        # The linker script for pw_boot_cortex_m.
        ":linker_script",
        # The initialization code.
        ":pre_init",
        # Arm GCC support libraries.
        "@pigweed//pw_toolchain/arm_gcc:arm_none_eabi_gcc_support",
    ],
)

pw_linker_script(
    name = "linker_script",
    defines = [
        "PW_BOOT_FLASH_BEGIN=0x08000200",
        # Up to the last sector (11, 128 KB at 0x080E0000), which holds the
        # saved voiceprint (modules/voice_store) and so must survive
        # flashing: 0x080E0000 - 0x08000200 bytes.
        "PW_BOOT_FLASH_SIZE=916992",
        "PW_BOOT_HEAP_SIZE=7K",
        "PW_BOOT_MIN_STACK_SIZE=1K",
        "PW_BOOT_RAM_BEGIN=0x20000000",
        # Unlike the F429 (which has 192K genuinely contiguous at 0x20000000
        # via SRAM1+SRAM2+SRAM3), the F407's SRAM1+SRAM2 span only 128K
        # contiguous here (112K + 16K). The remaining 64K "CCM" RAM lives at
        # the separate, non-contiguous address 0x10000000 and isn't
        # DMA-accessible -- it's not usable as a simple extension of this
        # region. Using 192K here (copied uncritically from the F429 target)
        # put the stack 64K past the end of real memory and hard-faulted on
        # the very first stack push in boot, before any application code ran.
        "PW_BOOT_RAM_SIZE=128K",
        "PW_BOOT_VECTOR_TABLE_BEGIN=0x08000000",
        "PW_BOOT_VECTOR_TABLE_SIZE=512",
    ],
    linker_script = "@pigweed//pw_boot_cortex_m:basic_cortex_m.ld",
)
